# Local development against the deployed AWS HTTP API.
# Copy this file to .env.local, then replace placeholders with CloudFormation outputs.
VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.ap-southeast-1.amazonaws.com/api

# AWS Cognito
VITE_COGNITO_ENABLED=true
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=YOUR_WEB_CLIENT_ID

# Optional legacy Google OAuth. Leave empty when not used.
VITE_GOOGLE_CLIENT_ID=
