{
  "name": "project-hospital-aws-p2tb",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital P2TB AWS project with medical records, laboratory workflow, medical audit blockchain anchoring, payment gateways and SNS OTP.",
  "scripts": {
    "build": "node scripts/check-js.js",
    "test": "node --test tests/*.test.js",
    "synth": "cdk synth",
    "diff": "cdk diff HospitalDevStack",
    "deploy": "cdk deploy HospitalDevStack",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "outputs": "node scripts/export-outputs.js",
    "deploy:web": "node scripts/deploy-web.js",
    "create:users": "node scripts/create-demo-users.js",
    "smoke": "node scripts/smoke-test.js",
    "check": "npm run build && npm test && npm run synth && npm run build:web",
    "seed:data": "node scripts/seed-dynamodb.js",
    "verify:data": "node scripts/verify-dynamodb-data.js",
    "reset:data": "node scripts/reset-dynamodb-data.js",
    "test:medical": "node --test tests/medical-handler.test.js",
    "seed:medical": "node scripts/seed-medical-data.js",
    "verify:medical": "node scripts/verify-medical-data.js",
    "tokens:medical": "node scripts/get-demo-tokens.js",
    "test:medical:api": "node scripts/test-medical-api.js",
    "synth:edge": "node scripts/cdk-target.js edge synth HospitalEdgeStack",
    "diff:edge": "node scripts/cdk-target.js edge diff HospitalEdgeStack",
    "deploy:edge": "node scripts/cdk-target.js edge deploy HospitalEdgeStack",
    "outputs:edge": "node scripts/export-edge-outputs.js",
    "synth:app": "node scripts/cdk-target.js app synth HospitalDevStack",
    "diff:app": "node scripts/cdk-target.js app diff HospitalDevStack",
    "deploy:app": "node scripts/cdk-target.js app deploy HospitalDevStack",
    "destroy:edge": "node scripts/cdk-target.js edge destroy HospitalEdgeStack",
    "destroy:app": "node scripts/cdk-target.js app destroy HospitalDevStack",
    "test:ai": "node scripts/test-external-ai.js",
    "verify:no-bedrock": "node scripts/verify-no-bedrock.js",
    "test:core": "node --test tests/core*.test.js tests/auth.test.js tests/http.test.js tests/validation.test.js tests/dynamodb.test.js",
    "test:worker": "node --test tests/core-worker.test.js",
    "check:hoangphuc": "npm run build && npm test && npm run validate:data:local && npm run synth:app && npm run build:web",
    "validate:data:local": "node scripts/validate-dataset-local.js",
    "test:core:api": "node scripts/test-core-api.js",
    "test:dinhbao": "node --test tests/medical-handler.test.js tests/lab-workflow.test.js tests/medical-audit.test.js tests/payment-sms.test.js",
    "test:payment": "node --test tests/payment-sms.test.js",
    "test:audit": "node --test tests/medical-audit.test.js",
    "test:lab": "node --test tests/lab-workflow.test.js",
    "test:week3:api": "node scripts/test-payment-sms-api.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1075.0",
    "@aws-sdk/client-cloudfront": "^3.850.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1075.0",
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/client-secrets-manager": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@aws-sdk/lib-dynamodb": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.4.2",
    "@aws-sdk/client-sns": "^3.1075.0",
    "@aws-sdk/util-dynamodb": "^3.996.5",
    "ethers": "6.16.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.260.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  }
}
